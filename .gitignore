# ── Dependencies ──────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*

# ── Build output ──────────────────────────────────────────────
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# ── Env & secrets (NEVER commit) ──────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/

# ── Testing / coverage ────────────────────────────────────────
coverage/
.nyc_output/
playwright-report/
test-results/

# ── Logs ──────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS / editor ───────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# ── Rendered / generated documents (transient dev artifacts) ──
/tmp-render/
*.local.pdf

# ── Turbo / caches ────────────────────────────────────────────
.turbo/
.vercel/
