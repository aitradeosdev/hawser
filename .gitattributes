# Normalize line endings to LF in the repo; check out native on each OS.
# Prevents CRLF/LF churn on this Windows machine.
* text=auto eol=lf

# Binary / generated assets — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

# Lockfiles: keep LF, mark as generated (collapse in diffs)
package-lock.json -diff linguist-generated=true
