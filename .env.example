# Attestly — environment variable template
# Copy to `.env.local` (git-ignored). Values below are placeholders. Grouped by subsystem; most are
# forward-looking (added as each subsystem is built). Never commit real secrets.

# ── Core app ──────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000

# ── Database (Postgres — Supabase default / Neon alt) ─────────
# DATABASE_URL=postgres://user:pass@host:5432/attestly
# DIRECT_URL=                      # non-pooled connection for migrations (Drizzle)

# ── Object storage (Cloudflare R2 default / S3 alt) ───────────
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=attestly-documents
# R2_PUBLIC_BASE_URL=

# ── Auth / orgs (WorkOS default; Better Auth if EU residency) ─
# WORKOS_API_KEY=
# WORKOS_CLIENT_ID=
# WORKOS_COOKIE_PASSWORD=          # 32+ char secret for session cookie encryption
# --- OR Better Auth ---
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000

# ── Rendering microservice (self-hosted Playwright) ──────────
# RENDERER_URL=http://localhost:4000
# RENDERER_SHARED_SECRET=          # HMAC between app and renderer

# ── Redis (Upstash — sessions/rate-limit/job state) ──────────
# REDIS_URL=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Payments (Stripe) ─────────────────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── KYB / org verification (Middesk / Inscribe / etc.) ────────
# KYB_PROVIDER_API_KEY=

# ── Verification portal & signing (V1+) ──────────────────────
# VERIFICATION_BASE_URL=           # e.g. https://verify.<issuer-domain>
# SIGNING_KMS_KEY_ID=              # HSM/KMS key for PAdES/C2PA signing
