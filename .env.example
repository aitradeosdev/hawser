# ── Required ──────────────────────────────────────────────────────────────
# Supabase project (Realtime is used for signaling only; no data is stored).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical deployment URL (e.g. https://hawser.example.com), used for
# resolving social card images.
NEXT_PUBLIC_SITE_URL=

# ── Strongly recommended ─────────────────────────────────────────────────
# TURN relay for networks that block peer-to-peer. Without it, some pairs
# will never connect and the app fails at the connect timeout.
# Comma-separated list of turn:/turns: URLs sharing one credential pair.
NEXT_PUBLIC_TURN_URLS=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# ── Server-only (keepalive cron) ─────────────────────────────────────────
# Service role key: used by /api/heartbeat to write the daily keepalive row.
SUPABASE_SERVICE_ROLE_KEY=
# Set in Vercel; Vercel Cron sends it as "Authorization: Bearer <secret>".
CRON_SECRET=

# ── Optional tuning (defaults shown) ─────────────────────────────────────
# Comma-separated STUN URLs.
NEXT_PUBLIC_STUN_URLS=stun:stun.l.google.com:19302
# Data channel chunk size in bytes (16 KiB is the interoperable ceiling).
NEXT_PUBLIC_CHUNK_BYTES=16384
# Pause sending above this much unsent buffered data (bytes).
NEXT_PUBLIC_HIGH_WATER_BYTES=1048576
# Resume sending once the buffer drains to this level (bytes).
NEXT_PUBLIC_LOW_WATER_BYTES=262144
# Give up on connecting after this many milliseconds.
NEXT_PUBLIC_CONNECT_TIMEOUT_MS=20000
# Warn before sending files larger than this (bytes); receiver holds them in memory.
NEXT_PUBLIC_MEMORY_WARN_BYTES=524288000
# Client-side Realtime message rate (ICE trickle can burst past the default 10).
NEXT_PUBLIC_REALTIME_EVENTS_PER_SECOND=50
